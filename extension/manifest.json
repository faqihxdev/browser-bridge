{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.1.0",
  "description": "Connect local agents to browser APIs and manage their active tabs.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "bookmarks",
    "history",
    "downloads",
    "cookies",
    "sessions",
    "management",
    "browsingData",
    "privacy",
    "contentSettings",
    "topSites",
    "fontSettings",
    "storage",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Bridge"
  },
  "key": ""
}
