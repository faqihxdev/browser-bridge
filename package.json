{
  "name": "browser-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser control for agents, with shared sessions and visible activity.",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "browser-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "start": "node dist/cli.js daemon",
    "status": "node dist/cli.js status",
    "browsers": "node dist/cli.js browsers",
    "setup:local": "node dist/cli.js setup",
    "doctor": "node dist/cli.js doctor",
    "stop": "node dist/cli.js stop",
    "test:extension": "node --import tsx --test tests/extension/*.test.ts",
    "mcp": "node dist/cli.js mcp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
